# Copy to .env (never commit it) or set these in your hosting provider's dashboard.
PMM_ENV=production
PMM_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
# PostgreSQL recommended in the cloud; leave unset to use local SQLite (instance/mortgages.db).
DATABASE_URL=postgresql://user:password@host:5432/mortgages
# Creates the first admin login on startup if no users exist yet.
PMM_ADMIN_EMAIL=you@example.com
PMM_ADMIN_PASSWORD=choose-a-long-password
# Set to 1 (with the two above) to reset that account's password on start-up if you're locked out; remove afterwards.
# PMM_ADMIN_RESET=1
# Set to 0 to disable fetching live Bank of Canada data.
PMM_MARKET_FETCH=1
# Your local time zone — "today", due dates and arrears roll over at your midnight, not the server's (UTC).
PMM_TIMEZONE=America/Toronto
